{
  "manifest_version": 3,
  "name": "AgentDemo",
  "version": "0.1.0",
  "description": "Navigate and annotate executed LLM conversations for clean solution-consultant demos.",
  "permissions": ["storage", "unlimitedStorage", "clipboardWrite"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "AgentDemo — click to toggle",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": { "service_worker": "bg.js" },
  "host_permissions": [
    "https://experience.adobe.com/*",
    "https://aemcoder.adobe.io/*",
    "https://da.live/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["pn.js"]
    }
  ]
}
