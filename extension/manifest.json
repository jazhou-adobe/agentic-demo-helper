{
  "manifest_version": 3,
  "name": "AgentDemo",
  "version": "0.1.0",
  "description": "Navigate and annotate executed LLM conversations for clean solution-consultant demos.",
  "permissions": ["storage", "unlimitedStorage", "clipboardWrite"],
  "action": { "default_title": "AgentDemo — click to toggle" },
  "background": { "service_worker": "bg.js" },
  "host_permissions": [
    "https://experience.adobe.com/*",
    "https://aemcoder.adobe.io/*",
    "https://da.live/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["pn.js"]
    }
  ]
}
